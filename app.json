{
  "expo": {
    "name": "Archie's",
    "slug": "archies-retro",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "archies",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.archies.retro"
    },
    "android": {
      "package": "co.archies.retro"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "backgroundColor": "#FF1F7A",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a35cd5ee-e31d-4656-aacf-04c35a279119"
      }
    },
    "owner": "musty-test",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a35cd5ee-e31d-4656-aacf-04c35a279119"
    }
  }
}
